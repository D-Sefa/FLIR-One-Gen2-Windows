<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.dsefa.flir" android:versionCode="1" android:versionName="0.1.0-preview">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
